{
  "name": "smartfood-backend",
  "version": "1.0.0",
  "description": "Backend SmartFood - I.E. Normal Superior Montes de María",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "mysql2": "^3.6.0",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.4",
    "sequelize": "^6.33.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.0.1",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/helpers/setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/helpers/",
      "modelos.mock.js"
    ],
    "collectCoverageFrom": [
      "routes/**/*.js",
      "middleware/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary"
    ]
  }
}
